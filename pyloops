    "      if y > x:\n",
    "         y = y - 1\n",
    "      else:\n",
    "           y=y\n",
    "else:\n",
    "    if y < x:\n",
    "        y = y + 1\n",
    "    else: \n",
    "        y = y  \n",
    "if y % 2 == 0:\n",
    "      print('EVEN')\n",
